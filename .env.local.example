NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=production

# ── Staging preview (Option 1) ──────────────────────────────────────────────
# Local dev behaves like staging when both are set:
SANITY_PREVIEW_MODE=true
# Viewer token — required to see unpublished drafts on staging / locally.
# Create at manage.sanity.io → API → Tokens (Viewer)
SANITY_API_READ_TOKEN=your_viewer_token

# Production URL fallback (Site Settings → Production URL in Sanity is preferred)
# NEXT_PUBLIC_SITE_URL=https://noideas.website

# ── Mailchimp (/info signup) ──────────────────────────────────────────────────
# NEXT_PUBLIC_MAILCHIMP_FORM_ACTION=https://yourdomain.us1.list-manage.com/subscribe/post?u=...&id=...
# NEXT_PUBLIC_MAILCHIMP_HONEYPOT_NAME=b_xxxxxxxxxx_yyyyyyyyyy

# ── Sanity seed scripts (Editor token) ────────────────────────────────────────
# SANITY_API_TOKEN=your_token
