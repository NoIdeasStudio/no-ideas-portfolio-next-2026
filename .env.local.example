NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=production

# Fallback production URL when Site Settings → Production URL is not set in Sanity.
# NEXT_PUBLIC_SITE_URL=https://noideas.com

# Required for local draft preview (Presentation tool).
# Create at manage.sanity.io → API → Tokens (Viewer), then restart `npm run dev`.
# SANITY_API_READ_TOKEN=your_viewer_token

# If you run standalone Studio (`npm run sanity`) on port 3333, set the Next.js origin:
# SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000

# Mailchimp signup on /info — paste from Audience → Signup forms → Embedded forms (action URL includes u, id, and often f_id).
# NEXT_PUBLIC_MAILCHIMP_FORM_ACTION=https://yourdomain.us1.list-manage.com/subscribe/post?u=...&id=...&f_id=...
# Honeypot: name="b_..." on the hidden text field in the same embed (do not omit if Mailchimp provided it).
# NEXT_PUBLIC_MAILCHIMP_HONEYPOT_NAME=b_xxxxxxxxxx_yyyyyyyyyy

# For scripts/seed-dumbo-in-sanity.mjs (create example project in Sanity)
# Create token at https://manage.sanity.io → Project → API → Tokens (Editor)
# SANITY_API_TOKEN=your_token

