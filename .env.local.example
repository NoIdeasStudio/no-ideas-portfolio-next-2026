NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=production

# Mailchimp signup on /info — paste from Audience → Signup forms → Embedded forms (action URL includes u, id, and often f_id).
# NEXT_PUBLIC_MAILCHIMP_FORM_ACTION=https://yourdomain.us1.list-manage.com/subscribe/post?u=...&id=...&f_id=...
# Honeypot: name="b_..." on the hidden text field in the same embed (do not omit if Mailchimp provided it).
# NEXT_PUBLIC_MAILCHIMP_HONEYPOT_NAME=b_xxxxxxxxxx_yyyyyyyyyy

# For scripts/seed-dumbo-in-sanity.mjs (create example project in Sanity)
# Create token at https://manage.sanity.io → Project → API → Tokens (Editor)
# SANITY_API_TOKEN=your_token

# Draft / Presentation preview (Next.js Draft Mode + Studio Presentation tool)
# Create a read token with Viewer role (or custom) that can read draft documents.
# Server-only — never prefix with NEXT_PUBLIC_.
# SANITY_API_READ_TOKEN=your_read_token

# Optional: comma-separated extra origins allowed in Presentation (e.g. preview deployment URLs).
# NEXT_PUBLIC_SANITY_PREVIEW_ALLOW_ORIGINS=https://your-preview.vercel.app

# Public URL of the Next.js app (origin only). Presentation calls /api/draft-mode/enable on this host.
# Required if Studio runs elsewhere (e.g. `sanity dev` on :3333 while `next dev` is on :3000). Vercel sets NEXT_PUBLIC_VERCEL_URL when unset.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

